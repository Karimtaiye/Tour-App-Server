extends baseEmail

block content
    p Hello #{firstName},
    p Welcome to Tour-Server-App! Please verify your email address to complete your registration.
    p Click the button or the link below to verify your email:
    table.btn.btn-primary(role='presentation', border='0', cellpadding='0', cellspacing='0')
        tbody
            tr
                td(align='left')
                    table(role='presentation', border='0', cellpadding='0', cellspacing='0')
                        tbody
                            tr
                                td
                                    a(href=`${url}`, target='_blank') Verify Email

    p Verify Email Link 👇👇
    a(href=`${url}`, target='_blank')=url
    p If you did not create an account with Natours, please disregard this email.\nUnverified users will be deleted after 10 days
